{{ config (
    post_hook="COPY {{ this }} TO '../data/tracklog_clean.csv' (HEADER TRUE)"
)}}

SELECT 
    track_uid AS "track",  -- GPSBabel identificará esto como el ID/Nombre del track
    0 AS "trackseg",
    lat AS "latitude",
    lon AS "longitude",
    ele AS "altitude",    -- Altitud en metros
    -- GPSBabel requiere formato ISO: YYYY-MM-DD HH:MM:SS
    strftime(time, '%Y-%m-%d %H:%M:%S') AS "time" 
FROM {{ ref('clean_phase_2') }}
--    WHERE date_part('year', time) = 2010 -- El año que quieres exportar
ORDER BY track_uid, time

